# Copia este archivo a .env.local y completa los valores.
# .env.local NUNCA se sube al repo (está en .gitignore) — cada quien tiene
# el suyo. Ver README.md, sección "Variables de entorno", para la
# explicación completa de qué es segura de exponer aquí y por qué.

# URL y llave pública (anon) del proyecto de Supabase.
#
# Para desarrollo LOCAL: corren con "npm run db:start" y salen impresas en
# la terminal (o con "supabase status"). La URL local siempre es
# http://127.0.0.1:54321; la anon key es la misma para cualquier proyecto
# Supabase local (no es secreta, no cambia entre proyectos).
#
# Para staging/producción: se toman del panel de ese proyecto en
# supabase.com → Project Settings → API.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# SOLO para correr scripts (p. ej. "npm run superadmin:create"), NUNCA para el
# frontend: por eso NO lleva el prefijo VITE_ (Vite incrustaría en el bundle
# cualquier variable VITE_*, y esta llave salta RLS). Déjalas vacías salvo que
# vayas a correr un script contra un ambiente DESPLEGADO; para el Supabase
# local basta con la opción --local del script, que no las necesita.
# La service_role sale de supabase.com → Project Settings → API.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
